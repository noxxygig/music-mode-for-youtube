{
  "manifest_version": 3,
  "name": "Music Mode for YouTube™",
  "short_name": "Music Mode",
  "version": "1.0.0",
  "description": "Turns YouTube into a distraction-free music player: cover art instead of video, optional data saver.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Music Mode for YouTube™",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["https://www.youtube.com/*"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" },
    { "matches": ["https://www.youtube.com/*"], "js": ["main.js"], "world": "MAIN", "run_at": "document_idle" }
  ]
}
